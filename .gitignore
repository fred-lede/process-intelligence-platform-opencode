# Node
node_modules/
dist/
*.log
.npm/
release/
.worktrees/

# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# Frozen analysis engine (built by scripts/build-engine.mjs, shipped via
# bundle.resources). Never commit the bundle itself — CI builds it per target.
src-tauri/resources/engine/*
!src-tauri/resources/engine/.gitkeep

# Python
engine/.venv/
engine/build/
engine/dist/
engine/__pycache__/
engine/**/__pycache__/
engine/**/*.pyc
lightning_logs/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Project data (user projects)
projects/*
!projects/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
engine/.coverage
.coverage
